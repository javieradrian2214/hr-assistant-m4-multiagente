# Entornos y secretos
# Entornos virtuales en cualquier nivel
.venv*/
# Archivos de entorno en cualquier nivel, salvo la plantilla
.env
.env.*
!.env.example
# Archivos locales y configuración privada
/.claude/*
!/.claude/agents/
!/.claude/skills/
# settings.json y settings.local.json de .claude/ siguen ignorados (configuracion local).
.idea/
.mcp.json

# Cobertura y cachés
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
__pycache__/
*.py[cod]
.pylint.d/
.mypy_cache/
.ruff_cache/

# Archivos temporales y registros
*.log
.DS_Store
Thumbs.db

# Archivo de autorización de publicación pendiente de revisión
/output/approved.txt

# Registros internos de agentes
/output/activity.jsonl

# Configuración local de herramientas
/product/.claude/
/product/.venv*/

# Artefactos internos de ejecucion y agentes
/output/
