# Copia este archivo a .env y completa los valores. Nunca subas el .env.

# Entorno: development o production. Con production el producto se niega a
# arrancar si no cumple las reglas de doc/compliance-checklist.md.
ENVIRONMENT=development

# Acceso: una clave por cliente, con la forma cliente:clave,cliente2:clave2.
# Es un secreto. En production cada clave tiene al menos 16 caracteres.
API_KEYS=
# Peticiones por cliente por minuto (429 con Retry-After si se pasa)
RATE_LIMIT_PER_MINUTE=30

# Modelo: fake (simulado, sin red) o gateway (Cloudflare AI Gateway).
# En production debe ser gateway.
MODEL_PROVIDER=fake

# Cloudflare: con MODEL_PROVIDER=gateway, CF_ACCOUNT_ID y CF_API_TOKEN son
# obligatorias (el token es secreto). CF_GATEWAY_ID es opcional: vacía o solo
# espacios cae a default.
CF_ACCOUNT_ID=
CF_GATEWAY_ID=default
CF_API_TOKEN=

# Modelos y palancas de costo
MODEL_SMALL=@cf/meta/llama-3.1-8b-instruct-fast
MODEL_LARGE=@cf/meta/llama-3.3-70b-instruct-fp8-fast
ROUTING=true
ROUTER_MAX_CHARS=80
HISTORY_WINDOW=6
MODEL_MAX_TOKENS=300
MODEL_TEMPERATURE=0
CACHE_TTL_SECONDS=0
PRICES_PATH=data/model_prices.json
MODEL_TIMEOUT_SECONDS=30

# Límites del historial que manda el cliente (422 si se pasa)
MAX_HISTORY_MESSAGES=100
MAX_HISTORY_CHARS=8000

# Agente y datos
AGENT_MAX_STEPS=3
MAX_QUESTION_CHARS=2000
EMPLOYEES_PATH=data/employees.json

# Arquitectura multiagente (sesión 5)
# ORCHESTRATION: single (un agente) o multi (supervisor y especialistas).
# Ausente o vacía cae a single; cualquier otro valor impide arrancar.
ORCHESTRATION=single
# Largo máximo de la respuesta tras la guarda de salida (entero mayor que 0)
MAX_ANSWER_CHARS=2000

# Observabilidad (con trazas en production, HIDE_* deben ser true)
SERVICE_NAME=hr-assistant
SLO_P95_MS=2000
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
HIDE_INPUTS=true
HIDE_OUTPUTS=true
